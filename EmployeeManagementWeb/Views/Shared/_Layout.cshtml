<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> Hotel Mangement System </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
 <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav" style="background-color: ghostwhite;font-size: 22px;font-family: fantasy;">
                <ul class="navbar-nav" id="navBaar">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employee" asp-action="EmployeeDeatil" style="margin-left: 466px;">Add Employee</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Book Now</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">Room</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Guests" asp-action="Guest">Guest Management</a>
                    </li> 
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">Boking System</a>
                    </li> 
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">Payments</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <p class="container">
        <main role="main" class="pb-3" style="background-color: #FFFFFF;">
            @RenderBody()
        </main>
    </p>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>